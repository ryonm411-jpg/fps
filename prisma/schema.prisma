datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum MarketStatus {
  ACTIVE
  HALTED
  SUSPENDED
  DELISTED
}

enum LedgerType {
  INITIAL_GRANT
  DEPOSIT
  TRADE_BUY
  TRADE_SELL
  DIVIDEND
  ADJUSTMENT
}

model User {
  id                   String                @id @default(cuid())
  clerkId              String                @unique
  email                String                @unique
  username             String?               @unique
  name                 String?
  avatarUrl            String?
  virtualCash          Decimal               @default(10000.00) @db.Decimal(18, 2)
  holdings             Holding[]
  orders               Order[]
  buyerTrades          Trade[]               @relation("BuyerTrades")
  sellerTrades         Trade[]               @relation("SellerTrades")
  ledgerEntries        CashLedger[]
  watchlist            Watchlist[]
  posts                Post[]
  comments             Comment[]
  likes                Like[]
  leaderboardSnapshots LeaderboardSnapshot[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([clerkId])
}

model Club {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  logoUrl   String?
  league    String
  players   Player[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  position     String
  nationality  String
  age          Int
  avatarUrl    String?
  number       Int?
  clubId       String
  club         Club           @relation(fields: [clubId], references: [id])
  market       Market?
  holdings     Holding[]
  orders       Order[]
  trades       Trade[]
  pricePoints  PricePoint[]
  stats        FootballStat[]
  playerNews   PlayerNews[]
  posts        Post[]
  watchlists   Watchlist[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([clubId])
  @@index([slug])
}

model Market {
  id           String       @id @default(cuid())
  playerId     String       @unique
  player       Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status       MarketStatus @default(ACTIVE)
  currentPrice Decimal      @default(0.00) @db.Decimal(18, 2)
  high24h      Decimal      @default(0.00) @db.Decimal(18, 2)
  low24h       Decimal      @default(0.00) @db.Decimal(18, 2)
  volume24h    Decimal      @default(0.00) @db.Decimal(18, 2)
  change24h    Decimal      @default(0.00) @db.Decimal(18, 2)
  orders       Order[]
  trades       Trade[]
  pricePoints  PricePoint[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([playerId])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  marketId       String
  market         Market      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  type           OrderType   @default(LIMIT)
  side           OrderSide
  price          Decimal     @db.Decimal(18, 2)
  quantity       Int
  filledQuantity Int         @default(0)
  status         OrderStatus @default(OPEN)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([playerId])
  @@index([marketId])
  @@index([status, side, price])
}

model Trade {
  id         String   @id @default(cuid())
  buyerId    String
  buyer      User     @relation("BuyerTrades", fields: [buyerId], references: [id])
  sellerId   String
  seller     User     @relation("SellerTrades", fields: [sellerId], references: [id])
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  marketId   String
  market     Market   @relation(fields: [marketId], references: [id])
  price      Decimal  @db.Decimal(18, 2)
  quantity   Int
  totalValue Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  @@index([buyerId])
  @@index([sellerId])
  @@index([playerId])
  @@index([marketId])
  @@index([createdAt])
}

model Holding {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  quantity       Int      @default(0)
  averageBuyPrice Decimal @default(0.00) @db.Decimal(18, 2)
  totalCost      Decimal  @default(0.00) @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, playerId])
  @@index([userId])
  @@index([playerId])
}

model CashLedger {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(18, 2)
  balanceAfter Decimal    @db.Decimal(18, 2)
  type         LedgerType
  description  String
  referenceId  String?
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, playerId])
  @@index([userId])
}

model PricePoint {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(18, 2)
  volume    Decimal  @default(0.00) @db.Decimal(18, 2)
  timestamp DateTime @default(now())

  @@index([playerId, timestamp])
  @@index([marketId, timestamp])
}

model FootballStat {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchDate     DateTime
  minutesPlayed Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  rating        Decimal  @default(0.0) @db.Decimal(4, 2)
  passes        Int      @default(0)
  tackles       Int      @default(0)
  cleanSheet    Boolean  @default(false)
  rawData       Json?
  createdAt     DateTime @default(now())

  @@index([playerId, matchDate])
}

model NewsArticle {
  id          String       @id @default(cuid())
  title       String
  summary     String
  url         String       @unique
  source      String
  imageUrl    String?
  publishedAt DateTime
  playerNews  PlayerNews[]
  createdAt   DateTime     @default(now())

  @@index([publishedAt])
}

model PlayerNews {
  id            String      @id @default(cuid())
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  newsArticleId String
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([playerId, newsArticleId])
  @@index([playerId])
}

model Post {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String?
  player    Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  content   String
  comments  Comment[]
  likes     Like[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([playerId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model LeaderboardSnapshot {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank             Int
  totalValue       Decimal  @db.Decimal(18, 2)
  returnPercentage Decimal  @db.Decimal(8, 4)
  period           String   @default("ALL_TIME")
  snapshotDate     DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([period, rank])
  @@index([userId])
}
