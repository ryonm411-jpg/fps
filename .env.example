# ==========================================
# Football Player Market - Environment Variables
# ==========================================

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/football_market?schema=public"

# Clerk Authentication
# Obtain from Clerk Dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/markets"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/markets"

# Sentry Error Monitoring
# Obtain from Sentry Dashboard: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# PostHog Product Analytics
# Obtain from PostHog Dashboard: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# App Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
